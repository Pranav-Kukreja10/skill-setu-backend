DEBUG=True
SECRET_KEY=your-django-secret-key-here

# PostgreSQL Settings
DB_NAME=skillsetu_db
DB_USER=skillsetu_user
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=5432

# AI Model Provider Routing
AI_PROVIDER=cloud  # Options: local | cloud | mock

# Local Ollama Settings (Optional, for GPU/local inference)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Cloud AI Settings (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key

MODEL_RESUME_PARSER=gemini-3.1-flash-lite
MODEL_TEST_GENERATOR=gemini-3.5-flash-lite
MODEL_GRADER=gemini-3.1-flash-lite
